# ============================================================================
# AccesMed — Backend en el servidor: variables de docker/deploy/docker-compose.yml
# ============================================================================
# Este `.env` vive SOLO en el servidor, junto al compose, con permisos 600:
#
#   /root/docker/accesmed/staging/back/.env
#   /root/docker/accesmed/prod/back/.env
#
# Nunca se versiona con valores reales. Ver Docs/DEPLOY.md.
# Formato docker compose: sin comillas ni espacios alrededor del `=`.
# ============================================================================

# --- Identidad del entorno (staging | prod) ---
# ACCESMED_ENV define el perfil de Spring, los nombres de contenedor y la red.
COMPOSE_PROJECT_NAME=accesmed-staging-back
ACCESMED_ENV=staging
# Tag de la imagen en GHCR. `staging`/`prod` = último build de la rama; para hacer
# rollback se pone un tag `sha-<commit>` y se corre `docker compose up -d`.
IMAGE_TAG=staging

# --- Recursos ---
# Puerto publicado en el host (prod: 8080, staging: 8081).
BACK_PORT=8081
BACK_MEM_LIMIT=1g
JAVA_OPTS=-XX:MaxRAMPercentage=75

# --- Postgres ---
POSTGRES_DB=accesmed
POSTGRES_USER=accesmed
POSTGRES_PASSWORD=

# --- SMTP (Gmail, contraseña de aplicación) ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- JWT (HS512: mínimo 64 caracteres aleatorios, distinto por entorno) ---
# openssl rand -hex 64
ACCESMED_JWT_SECRET=

# --- SuperAdmin (bootstrap; sin contraseña no se crea) ---
# Solo se usa en el PRIMER arranque, cuando el SuperAdmin todavía no existe. Cambiarla
# después no cambia la contraseña de login: eso se hace desde la app (cambiar contraseña).
ACCESMED_SUPERADMIN_MAIL=
ACCESMED_SUPERADMIN_PASSWORD=

# --- Documentación: Swagger UI y /v3/api-docs (HTTP Basic, obligatoria) ---
# Sin contraseña el back no arranca. openssl rand -base64 18
ACCESMED_DOCS_USERNAME=accesmed
ACCESMED_DOCS_PASSWORD=

# --- Canal chatbot: agente de WhatsApp (Chatwoot -> back -> Flowise) ---
# Clave compartida con Flowise (header X-Agente-Api-Key). Obligatoria. openssl rand -hex 32
ACCESMED_AGENTE_API_KEY=
# Chatwoot: token de acceso (obligatorio) y secret del Agent Bot (vacío = no verifica la firma).
ACCESMED_CHATWOOT_BASE_URL=https://chat.accesmed.site
ACCESMED_CHATWOOT_ACCOUNT_ID=1
ACCESMED_CHATWOOT_API_TOKEN=
ACCESMED_CHATWOOT_WEBHOOK_SECRET=
# Flowise: id del chatflow del agente (obligatorio) y su API key (vacía si no se usa).
ACCESMED_FLOWISE_BASE_URL=http://accesmed-flowise:3000
ACCESMED_FLOWISE_CHATFLOW_ID=
ACCESMED_FLOWISE_API_KEY=
# OpenAI para el audio del canal (opcional: vacia = audio apagado).
ACCESMED_OPENAI_API_KEY=

# --- URLs del front de este entorno ---
ACCESMED_CORS_ALLOWED_ORIGINS=http://66.97.46.100:3001
ACCESMED_FRONTEND_BASE_URL=http://66.97.46.100:3001
