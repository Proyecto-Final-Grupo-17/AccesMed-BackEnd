# AccesMed DEV — variables para docker/dev/docker-compose.yml
# Copiá este archivo a `.env` (en la misma carpeta) y completá.
# El `.env` real NO se versiona (está en .gitignore).

# --- Postgres ---
POSTGRES_DB=accesmed
POSTGRES_USER=accesmed
POSTGRES_PASSWORD=cambia_esto
POSTGRES_PORT=5432

# --- pgAdmin (opcional) ---
PGADMIN_EMAIL=admin@accesmed.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- JWT ---
ACCESMED_JWT_SECRET=cambiar-este-valor-en-produccion-por-uno-largo-y-aleatorio
