# ============================================================================
# AccesMed — Backend: variables de entorno del perfil `dev`
# ============================================================================
# Copiá este archivo a `.env` (misma carpeta, la raíz del proyecto) y completá
# los valores. El `.env` real NO se versiona (está en .gitignore).
#
#   cp .env.example .env
#
# Lo lee Spring Boot al arrancar vía `spring.config.import` (application.yml).
# Son las variables SIN default: si falta alguna, el contexto no levanta.
# Una variable de entorno del shell le gana al valor de este archivo.
#
# Formato: es un archivo .properties. Una `#` inicia comentario y `\` escapa,
# así que no uses comillas alrededor del valor ni dejes espacios al final.
#
# OJO: no confundir con `docker/dev/.env`, que es el de docker-compose
# (credenciales de la Postgres local).
# ============================================================================

# --- SMTP (Gmail) ---
# Cuenta desde la que salen los mails de la app (activación de cuenta, reseteo
# de contraseña, recordatorios de turno). Gmail usa este mismo mail como
# remitente: no hay propiedad de `from` aparte.
MAIL_USERNAME=proyectofinalgrupo17@gmail.com

# NO es la contraseña de la cuenta de Google: es una "contraseña de aplicación"
# de 16 caracteres, que requiere tener la verificación en dos pasos activada
# (myaccount.google.com → Seguridad → Verificación en 2 pasos → Contraseñas de
# aplicaciones). Pegala sin espacios.
MAIL_PASSWORD=locfwmihssegdzia

# --- JWT ---
# Secreto de firma de los access token (HS512). En dev cualquier cadena larga
# sirve; en staging/prod tiene que ser larga y aleatoria, y llegar por entorno.
ACCESMED_JWT_SECRET=cambiar-este-valor-en-produccion-por-uno-largo-y-aleatorio

# --- SuperAdmin (bootstrap) ---
# Al arrancar, la app crea este usuario con el rol SuperAdmin si todavía no existe
# (SuperAdminInicializador). El login es por mail, así que tiene que ser un mail
# válido. Sin contraseña el usuario NO se crea y el arranque sigue con un aviso.
ACCESMED_SUPERADMIN_MAIL=superadmin@accesmed.com
ACCESMED_SUPERADMIN_PASSWORD=cambiar-por-una-contrasena-propia
