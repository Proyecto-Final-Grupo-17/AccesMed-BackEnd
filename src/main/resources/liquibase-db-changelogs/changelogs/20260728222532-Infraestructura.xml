<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Changeset inicial: solo infraestructura, sin tablas de negocio todavia.

        Habilita la extension pgcrypto de PostgreSQL, que provee la funcion
        gen_random_uuid(). Se necesita desde el arranque porque todas las
        entidades del modelo (Turno, Medico, Paciente, Usuario, etc.) usan
        UUID como clave primaria.

        Liquibase gestiona sus propias tablas de control (DATABASECHANGELOG
        y DATABASECHANGELOGLOCK) de forma automatica; no se declaran aca.
    -->
    <changeSet id="20260728222532-enabled-extension-pgcrypto" author="franco">
        <sql>CREATE EXTENSION IF NOT EXISTS pgcrypto;</sql>
        <rollback>
            <sql>DROP EXTENSION IF EXISTS pgcrypto;</sql>
        </rollback>
    </changeSet>

    <!--
        Habilita btree_gist, que permite combinar operadores de igualdad (=) con
        operadores de rango (&&) dentro de una misma constraint EXCLUDE USING gist.
        Va aca y no en el changelog de la primera entidad que la usa porque la
        necesitan varias tablas de distintas fases: las clases que se rigen por
        vigencia y deben garantizar que sus periodos no se solapen
        (medico_prestacion, agenda_medico, indicacion_prestacion, usuario_rol).
    -->
    <changeSet id="20260728222533-enabled-extension-btree-gist" author="claude">
        <sql>CREATE EXTENSION IF NOT EXISTS btree_gist;</sql>
        <rollback>
            <sql>DROP EXTENSION IF EXISTS btree_gist;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
