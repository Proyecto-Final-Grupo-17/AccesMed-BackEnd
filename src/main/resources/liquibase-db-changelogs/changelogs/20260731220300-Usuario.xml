<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260731220300-added-table-Usuario" author="claude">
        <createTable tableName="usuario">
            <!-- ====== Columnas ====== -->
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" primaryKeyName="pk_usuario"/>
            </column>
            <column name="mail" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
            <column name="password_hash" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <!-- ====== Relaciones ====== -->
            <column name="medico_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_usuario_medico" references="medico(id)" unique="true" uniqueConstraintName="uq_usuario_medico"/>
            </column>
            <column name="admin_id" type="uuid">
                <constraints nullable="true" foreignKeyName="fk_usuario_admin" references="admin(id)" unique="true" uniqueConstraintName="uq_usuario_admin"/>
            </column>
            <!-- ====== Columnas auditoría (incluye a la baja) ====== -->
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz"/>
            <column name="created_by" type="varchar(255)"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="deleted_at" type="timestamptz"/>
            <column name="deleted_by" type="uuid"/>
            <column name="deleted_reason" type="varchar(500)"/>
        </createTable>

        <sql>ALTER TABLE usuario ADD CONSTRAINT ck_usuario_medico_xor_admin CHECK ((medico_id IS NULL) &lt;&gt; (admin_id IS NULL));</sql>
        <sql>CREATE UNIQUE INDEX uq_usuario_mail ON usuario (mail) WHERE deleted_at IS NULL;</sql>
        <rollback>
            <sql>ALTER TABLE usuario DROP CONSTRAINT IF EXISTS ck_usuario_medico_xor_admin;</sql>
            <sql>DROP INDEX IF EXISTS uq_usuario_mail;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
