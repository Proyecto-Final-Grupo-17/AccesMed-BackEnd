<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260731214900-added-table-ObraSocial" author="claude">
        <createTable tableName="obra_social">
            <!-- ====== Columnas ====== -->
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" primaryKeyName="pk_obra_social"/>
            </column>
            <column name="codigo" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="nombre" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
            <column name="razon_social" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <!-- ====== Columnas auditoría (incluye a la baja) ====== -->
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz"/>
            <column name="created_by" type="varchar(255)"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="deleted_at" type="timestamptz"/>
            <column name="deleted_by" type="uuid"/>
            <column name="deleted_reason" type="varchar(500)"/>
        </createTable>

        <sql>CREATE UNIQUE INDEX uq_obra_social_codigo ON obra_social (codigo) WHERE deleted_at IS NULL;</sql>
        <sql>CREATE UNIQUE INDEX uq_obra_social_nombre ON obra_social (nombre) WHERE deleted_at IS NULL;</sql>
        <rollback>
            <sql>DROP INDEX IF EXISTS uq_obra_social_codigo;</sql>
            <sql>DROP INDEX IF EXISTS uq_obra_social_nombre;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
