<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260731214600-added-table-Especialidad" author="claude">
        <createTable tableName="especialidad">
            <!-- ====== Columnas ====== -->
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" primaryKeyName="pk_especialidad"/>
            </column>
            <column name="codigo" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="nombre" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <!-- ====== Columnas auditoría (incluye a la baja) ====== -->
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz"/>
            <column name="created_by" type="varchar(255)"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="deleted_at" type="timestamptz"/>
            <column name="deleted_by" type="uuid"/>
            <column name="deleted_reason" type="varchar(500)"/>
        </createTable>

        <sql>CREATE UNIQUE INDEX uq_especialidad_codigo ON especialidad (codigo) WHERE deleted_at IS NULL;</sql>
        <sql>CREATE UNIQUE INDEX uq_especialidad_nombre ON especialidad (nombre) WHERE deleted_at IS NULL;</sql>
        <rollback>
            <sql>DROP INDEX IF EXISTS uq_especialidad_codigo;</sql>
            <sql>DROP INDEX IF EXISTS uq_especialidad_nombre;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
