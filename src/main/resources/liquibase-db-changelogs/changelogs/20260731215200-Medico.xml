<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260731215200-added-table-Medico" author="claude">
        <createTable tableName="medico">
            <!-- ====== Columnas ====== -->
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" primaryKeyName="pk_medico"/>
            </column>
            <column name="matricula" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="dni" type="varchar(15)">
                <constraints nullable="false"/>
            </column>
            <column name="nombre" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="apellido" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
            <column name="numero_telefono" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <!-- ====== Relaciones ====== -->
            <column name="especialidad_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_medico_especialidad" references="especialidad(id)"/>
            </column>
            <!-- ====== Columnas auditoría (incluye a la baja) ====== -->
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz"/>
            <column name="created_by" type="varchar(255)"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="deleted_at" type="timestamptz"/>
            <column name="deleted_by" type="uuid"/>
            <column name="deleted_reason" type="varchar(500)"/>
        </createTable>

        <sql>CREATE UNIQUE INDEX uq_medico_matricula ON medico (matricula) WHERE deleted_at IS NULL;</sql>
        <sql>CREATE UNIQUE INDEX uq_medico_dni ON medico (dni) WHERE deleted_at IS NULL;</sql>
        <sql>CREATE INDEX idx_medico_especialidad ON medico (especialidad_id);</sql>
        <rollback>
            <sql>DROP INDEX IF EXISTS uq_medico_matricula;</sql>
            <sql>DROP INDEX IF EXISTS uq_medico_dni;</sql>
            <sql>DROP INDEX IF EXISTS idx_medico_especialidad;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
