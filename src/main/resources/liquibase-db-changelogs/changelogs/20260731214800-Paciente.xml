<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260731214800-added-table-Paciente" author="claude">
        <createTable tableName="paciente">
            <!-- ====== Columnas ====== -->
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" primaryKeyName="pk_paciente"/>
            </column>
            <column name="dni" type="varchar(15)">
                <constraints nullable="false"/>
            </column>
            <column name="nombre" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="apellido" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_nacimiento" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
            <column name="numero_telefono" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <!-- ====== Columnas auditoría (incluye a la baja) ====== -->
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz"/>
            <column name="created_by" type="varchar(255)"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="deleted_at" type="timestamptz"/>
            <column name="deleted_by" type="uuid"/>
            <column name="deleted_reason" type="varchar(500)"/>
        </createTable>

        <sql>ALTER TABLE paciente ADD CONSTRAINT ck_paciente_fecha_nacimiento_pasada CHECK (fecha_nacimiento &lt; CURRENT_DATE);</sql>
        <sql>CREATE UNIQUE INDEX uq_paciente_dni ON paciente (dni) WHERE deleted_at IS NULL;</sql>
        <sql>CREATE UNIQUE INDEX uq_paciente_numero_telefono ON paciente (numero_telefono) WHERE deleted_at IS NULL;</sql>
        <rollback>
            <sql>ALTER TABLE paciente DROP CONSTRAINT IF EXISTS ck_paciente_fecha_nacimiento_pasada;</sql>
            <sql>DROP INDEX IF EXISTS uq_paciente_dni;</sql>
            <sql>DROP INDEX IF EXISTS uq_paciente_numero_telefono;</sql>
        </rollback>
    </changeSet>

    <!--
        Normaliza numero_telefono a '+<dígitos>' (el formato del canal chatbot; Diseno-Chatbot §4.12 P2).
        Los pacientes dados de baja se normalizan siempre (el índice único no los alcanza). Los activos
        solo si ningún otro activo tiene los mismos dígitos: los duplicados por formato que ya existan
        quedan sin tocar para que los resuelva una persona (normalizarlos violaría uq_paciente_numero_telefono).
    -->
    <changeSet id="20261109120000-updated-table-Paciente-numero-telefono-e164" author="claude">
        <sql>
            UPDATE paciente p
            SET numero_telefono = '+' || regexp_replace(p.numero_telefono, '\D', '', 'g')
            WHERE p.numero_telefono &lt;&gt; '+' || regexp_replace(p.numero_telefono, '\D', '', 'g')
              AND length(regexp_replace(p.numero_telefono, '\D', '', 'g')) BETWEEN 7 AND 15
              AND (p.deleted_at IS NOT NULL
                   OR NOT EXISTS (SELECT 1 FROM paciente o
                                  WHERE o.id &lt;&gt; p.id AND o.deleted_at IS NULL
                                    AND regexp_replace(o.numero_telefono, '\D', '', 'g')
                                      = regexp_replace(p.numero_telefono, '\D', '', 'g')));
        </sql>
        <rollback/>
    </changeSet>

</databaseChangeLog>
