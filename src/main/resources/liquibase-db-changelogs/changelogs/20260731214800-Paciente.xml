<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260731214800-added-table-Paciente" author="claude">
        <createTable tableName="paciente">
            <!-- ====== Columnas ====== -->
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" primaryKeyName="pk_paciente"/>
            </column>
            <column name="dni" type="varchar(15)">
                <constraints nullable="false"/>
            </column>
            <column name="nombre" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="apellido" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_nacimiento" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
            <column name="numero_telefono" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <!-- ====== Columnas auditoría (incluye a la baja) ====== -->
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz"/>
            <column name="created_by" type="varchar(255)"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="deleted_at" type="timestamptz"/>
            <column name="deleted_by" type="uuid"/>
            <column name="deleted_reason" type="varchar(500)"/>
        </createTable>

        <sql>ALTER TABLE paciente ADD CONSTRAINT ck_paciente_fecha_nacimiento_pasada CHECK (fecha_nacimiento &lt; CURRENT_DATE);</sql>
        <sql>CREATE UNIQUE INDEX uq_paciente_dni ON paciente (dni) WHERE deleted_at IS NULL;</sql>
        <sql>CREATE UNIQUE INDEX uq_paciente_numero_telefono ON paciente (numero_telefono) WHERE deleted_at IS NULL;</sql>
        <rollback>
            <sql>ALTER TABLE paciente DROP CONSTRAINT IF EXISTS ck_paciente_fecha_nacimiento_pasada;</sql>
            <sql>DROP INDEX IF EXISTS uq_paciente_dni;</sql>
            <sql>DROP INDEX IF EXISTS uq_paciente_numero_telefono;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
