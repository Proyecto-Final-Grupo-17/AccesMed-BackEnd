<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260731215400-added-table-Plan" author="claude">
        <createTable tableName="plan">
            <!-- ====== Columnas ====== -->
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" primaryKeyName="pk_plan"/>
            </column>
            <column name="codigo" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="nombre" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
            <!-- ====== Relaciones ====== -->
            <column name="obra_social_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_plan_obra_social" references="obra_social(id)"/>
            </column>
            <!-- ====== Columnas auditoría (sin baja: Plan se retira por estados) ====== -->
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz"/>
            <column name="created_by" type="varchar(255)"/>
            <column name="updated_by" type="varchar(255)"/>
        </createTable>

        <!-- La unicidad de codigo/nombre por obra social "entre no-deshabilitados" ya no se
             refuerza en BD: dependia de estado_actual (eliminada). Ahora se valida en la capa
             de aplicacion (join al historico de estados vigente). Ver PlanDomainService. -->
        <rollback/>
    </changeSet>

</databaseChangeLog>
