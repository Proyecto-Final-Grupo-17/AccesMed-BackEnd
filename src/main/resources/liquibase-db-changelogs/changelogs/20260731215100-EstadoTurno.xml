<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260731215100-added-table-EstadoTurno" author="claude">
        <createTable tableName="estado_turno">
            <!-- ====== Columnas ====== -->
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" primaryKeyName="pk_estado_turno"/>
            </column>
            <column name="nombre" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <!-- ====== Columnas auditoría (incluye a la baja) ====== -->
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz"/>
            <column name="created_by" type="varchar(255)"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="deleted_at" type="timestamptz"/>
            <column name="deleted_by" type="uuid"/>
            <column name="deleted_reason" type="varchar(500)"/>
        </createTable>

        <sql>CREATE UNIQUE INDEX uq_estado_turno_nombre ON estado_turno (nombre) WHERE deleted_at IS NULL;</sql>
        <rollback>
            <sql>DROP INDEX IF EXISTS uq_estado_turno_nombre;</sql>
        </rollback>
    </changeSet>

    <!--
        Carga inicial: los nueve estados del DTE de Turno (modelo_dte_turno.json), en
        orden. Ojo: el estado se llama "En Transcurso", no "Iniciado".
    -->
