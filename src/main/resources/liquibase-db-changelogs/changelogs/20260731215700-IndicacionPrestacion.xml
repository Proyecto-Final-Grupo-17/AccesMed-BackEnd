<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Requerida por el EXCLUDE USING gist de mas abajo (no solapamiento de vigencias). -->
    <changeSet id="20260731215700-enabled-extension-btree-gist" author="claude">
        <sql>CREATE EXTENSION IF NOT EXISTS btree_gist;</sql>
        <rollback>
            <sql>DROP EXTENSION IF EXISTS btree_gist;</sql>
        </rollback>
    </changeSet>

    <changeSet id="20260731215701-added-table-IndicacionPrestacion" author="claude">
        <createTable tableName="indicacion_prestacion">
            <!-- ====== Columnas ====== -->
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" primaryKeyName="pk_indicacion_prestacion"/>
            </column>
            <column name="nombre" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
            <column name="descripcion" type="varchar(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="requiere_validacion" type="boolean">
                <constraints nullable="false"/>
            </column>
            <!-- ====== Vigencia ====== -->
            <column name="fecha_inicio_vigencia" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_fin_vigencia" type="timestamptz"/>
            <!-- ====== Relaciones ====== -->
            <column name="prestacion_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_indicacion_prestacion_prestacion" references="prestacion(id)"/>
            </column>
            <column name="tipo_indicacion_prestacion_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_indicacion_prestacion_tipo_indicacion_prestacion" references="tipo_indicacion_prestacion(id)"/>
            </column>
            <!-- ====== Columnas auditoría (sin baja: IndicacionPrestacion se gobierna por vigencia) ====== -->
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz"/>
            <column name="created_by" type="varchar(255)"/>
            <column name="updated_by" type="varchar(255)"/>
        </createTable>

        <sql>ALTER TABLE indicacion_prestacion ADD CONSTRAINT ck_indicacion_prestacion_vigencia CHECK (fecha_fin_vigencia IS NULL OR fecha_fin_vigencia > fecha_inicio_vigencia);</sql>

        <!-- No solapamiento de vigencias del mismo (prestacion, nombre): permite el relevo (cerrar una, abrir otra en el mismo corte) sin ambigüedad. -->
        <sql>
            ALTER TABLE indicacion_prestacion ADD CONSTRAINT ex_indicacion_prestacion_no_solapamiento
            EXCLUDE USING gist (
                prestacion_id WITH =,
                nombre WITH =,
                tstzrange(fecha_inicio_vigencia, fecha_fin_vigencia) WITH &amp;&amp;
            );
        </sql>

        <sql>CREATE INDEX idx_indicacion_prestacion_tipo_indicacion_prestacion ON indicacion_prestacion (tipo_indicacion_prestacion_id);</sql>
        <rollback>
            <sql>ALTER TABLE indicacion_prestacion DROP CONSTRAINT IF EXISTS ck_indicacion_prestacion_vigencia;</sql>
            <sql>ALTER TABLE indicacion_prestacion DROP CONSTRAINT IF EXISTS ex_indicacion_prestacion_no_solapamiento;</sql>
            <sql>DROP INDEX IF EXISTS idx_indicacion_prestacion_tipo_indicacion_prestacion;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
