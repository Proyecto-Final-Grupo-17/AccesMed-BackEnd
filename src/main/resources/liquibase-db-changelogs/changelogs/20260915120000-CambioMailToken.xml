<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260915120000-added-table-CambioMailToken" author="claude">
        <createTable tableName="cambio_mail_token">
            <!-- ====== Columnas ====== -->
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" primaryKeyName="pk_cambio_mail_token"/>
            </column>
            <column name="token_hash" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="used_at" type="timestamptz"/>
            <column name="mail_nuevo" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
            <!-- ====== Relaciones ====== -->
            <column name="usuario_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_cambio_mail_token_usuario" references="usuario(id)"/>
            </column>
            <!-- ====== Columnas auditoría (sin baja: no es una entidad con soft delete) ====== -->
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz"/>
            <column name="created_by" type="varchar(255)"/>
            <column name="updated_by" type="varchar(255)"/>
        </createTable>

        <sql>CREATE INDEX idx_cambio_mail_token_usuario ON cambio_mail_token (usuario_id);</sql>
        <sql>CREATE UNIQUE INDEX uq_cambio_mail_token_hash ON cambio_mail_token (token_hash);</sql>
        <rollback>
            <sql>DROP INDEX IF EXISTS idx_cambio_mail_token_usuario;</sql>
            <sql>DROP INDEX IF EXISTS uq_cambio_mail_token_hash;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
